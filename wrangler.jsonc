{
  "name": "echobell-one",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // Custom entry: wraps the SvelteKit worker and adds the /api/og image endpoint
  // (satori/resvg wasm modules must be bundled by wrangler, not Vite).
  "main": "src/worker/index.ts",
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS"
  },
  // D1 Database configuration
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "echobell",
      "database_id": "42f866b5-2d88-4364-b41c-51669cd88644"
    }
  ],
  // Observability configuration
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
